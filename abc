class Distribution(ABC):
    """
    Abstract base class for probability distributions.
    
    SSOT Contract: All family-specific math MUST be implemented here.
    External code (DA-EM, etc.) MUST use only this interface.
    
    Enforces:
    1. Parameter View: Native parameters that define the PDF/PMF
    2. Moment View: Statistical moments derived from parameters
    3. Canonical Interface: All operations go through abstract methods
    """
    
    @property
    @abstractmethod
    def location_param(self) -> float:
        """Location parameter (μ or equivalent center)."""
        pass
    
    @property
    @abstractmethod
    def scale_param(self) -> float:
        """Scale parameter (σ, b, or equivalent spread in native parameterization)."""
        pass
    
    @property
    @abstractmethod
    def shape_params(self) -> Dict[str, float]:
        """Shape parameters (ν, κ, etc.) as dict. Empty dict if none."""
        pass
    
    @property
    @abstractmethod
    def family_name(self) -> str:
        """Distribution family name (e.g., 'gauss', 'laplace', 'studt')."""
        pass
    
    @abstractmethod
    def pdf(self, x: np.ndarray) -> np.ndarray:
        """Probability density function at x using native parameters."""
        pass
    
    @abstractmethod
    def logpdf(self, x: np.ndarray) -> np.ndarray:
        """Log probability density function at x using native parameters."""
        pass
    
    @abstractmethod
    def logpdf_torch(self, x: torch.Tensor) -> torch.Tensor:
        """Log probability density (PyTorch version for gradient computation)."""
        pass
    
    # ==================== Moment View (External/Statistical) ====================
    
    @abstractmethod
    def mean(self) -> float:
        """First moment: Expected value E[X]."""
        pass
    
    @abstractmethod
    def variance(self) -> float:
        """Second central moment: Var[X] = E[(X-μ)²]."""
        pass
    
    def std(self) -> float:
        """Standard deviation: sqrt(Var[X])."""
        return np.sqrt(self.variance())
    
    @abstractmethod
    def skewness(self) -> float:
        """Third standardized moment: E[(X-μ)³]/σ³."""
        pass
    
    @abstractmethod
    def kurtosis(self) -> float:
        """Fourth standardized moment: E[(X-μ)⁴]/σ⁴ (excess kurtosis)."""
        pass
    
    # ==================== Serialization ====================
    
    def to_dict(self) -> Dict[str, Any]:
        """
        Serialize to dictionary using MOMENTS as the canonical storage format.
        This ensures consistent comparison across families.
        """
        result = {
            'family': self.family_name,
            'mu': self.location_param,
            'var': self.variance(),  # CRITICAL: Store actual variance, not scale²
        }
        if self.shape_params:
            result.update(self.shape_params)
        return result
    
    @classmethod
    @abstractmethod
    def from_dict(cls, d: Dict[str, Any]) -> Distribution:
        """Reconstruct from dictionary (inverse of to_dict)."""
        pass
    
    @classmethod
    @abstractmethod
    def fit(cls, data: np.ndarray) -> Distribution:
        """
        Fit distribution parameters to data via maximum likelihood estimation.

        Args:
            data: Observations to fit

        Returns:
            Fitted distribution instance
        """
        pass
    
    @abstractmethod
    def __init__(self, **params):
        """
        Initialize distribution with native parameters.
        Subclasses must store their specific parameters internally.
        """
        self._fitted_data = None
        self._cached_bps = None
    
    @staticmethod
    def create(family: str, **kwargs) -> Distribution:
        """Factory method to create distribution by family name."""
        registry = {
            'gauss': GaussianDistribution,
            'laplace': LaplaceDistribution,
            'studt': StudentTDistribution,
            'heteromix': HeteroMixture,
        }
        if family not in registry:
            raise ValueError(f"Unknown family: {family}")
        return registry[family].from_dict({'family': family, **kwargs})
    
    @abstractmethod
    def logpdf_backend(self, x: Any, xp: 'NumericsBackend') -> Any:
        """
        Log probability density using backend abstraction.

        This is the single authoritative PDF implementation. Works with both
        NumPy arrays and PyTorch tensors via the backend parameter.

        Args:
            x: Input data (NumPy array or PyTorch tensor)
            xp: Numerics backend (NP or TORCH)

        Returns:
            Log PDF values (same type as x)
        """
        pass
    
    def bps(self, data: np.ndarray | None = None) -> float:
        """
        Compute continuous negative log-likelihood in bits per sample.

        IMPORTANT: This returns the continuous NLL without quantization correction.
        For discrete/quantized data, the caller must add log₂(1/δ) per sample where
        δ is the effective bin width (instrument precision).

        If data is provided: fit this distribution class to the data and return bps.
        If data is None: return cached bps from last fit (raises if never fitted).

        The continuous NLL is:
            bps_continuous = -sum(log₂(p(x_i))) / n

        For proper coding cost comparison with quantized data:
            bps_total = bps_continuous + sum(log₂(1/δ_i)) / n

        Args:
            data: Optional data to fit and evaluate. If provided, triggers demand-driven fit.

        Returns:
            Continuous NLL in bits per sample (may be negative if PDF values > 1)

        Raises:
            ValueError: If called without data and no previous fit exists
        """
        if data is not None:
            # Demand-driven fit
            fitted = self.__class__.fit(data)
            # Transfer fitted params to self
            self.__dict__.update(fitted.__dict__)
            # Compute and cache continuous NLL
            nll_nats = -np.sum(self.logpdf(data))
            nll_bits = nll_nats / np.log(2)
            n = max(1, len(data))
            self._cached_bps = nll_bits / n
            self._fitted_data = data
            return self._cached_bps
        else:
            # Return cached result
            if self._cached_bps is None:
                raise ValueError("bps() called without data but no previous fit exists")
            return self._cached_bps
    
    @classmethod
    def validate_params(cls, params: Dict[str, Any]) -> None:
        """
        Validate parameter dictionary for this family.
        Raises ValueError if parameters are missing, invalid, or out of range.
        
        Args:
            params: Parameter dictionary with family-specific keys
        
        Raises:
            ValueError: If validation fails
        """
        # Subclasses should override to add family-specific validation
        if 'mu' not in params:
            raise ValueError(f"{cls.__name__} requires 'mu' parameter")
        
        mu = params['mu']
        if not np.isfinite(mu):
            raise ValueError(f"mu must be finite, got {mu}")
    
    @classmethod
    def apply_floors(cls, params: Dict[str, Any], floors: Dict[str, float]) -> Dict[str, Any]:
        """
        Apply precision floors to parameters.
        Returns new parameter dictionary with floors enforced.
        
        Args:
            params: Original parameters
            floors: Dictionary with floor values (e.g., {'sigma': 0.01, 'b': 0.01})
        
        Returns:
            New parameter dictionary with floors applied
        """
        # Subclasses should override to add family-specific floor logic
        return params.copy()
    
    def sample(self, n: int, rng: np.random.Generator = None) -> np.ndarray:
        """
        Generate random samples from this distribution.
        
        Args:
            n: Number of samples to generate
            rng: Random number generator (default: np.random.default_rng())
        
        Returns:
            Array of n samples
        """
        if rng is None:
            rng = np.random.default_rng()
        
        # Default implementation via inverse CDF (slow but general)
        # Subclasses should override with efficient sampling
        raise NotImplementedError(f"{self.__class__.__name__} does not implement sampling")

