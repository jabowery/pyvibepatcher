@classmethod
def validate_params(cls, params: Dict[str, Any]) -> None:
    """Validate Gaussian parameters."""
    super().validate_params(params)
    
    if 'var' not in params and 'sigma' not in params:
        raise ValueError("GaussianDistribution requires 'var' or 'sigma'")
    
    if 'var' in params:
        var = params['var']
        if not np.isfinite(var) or var <= 0:
            raise ValueError(f"var must be positive and finite, got {var}")
    
    if 'sigma' in params:
        sigma = params['sigma']
        if not np.isfinite(sigma) or sigma <= 0:
            raise ValueError(f"sigma must be positive and finite, got {sigma}")

